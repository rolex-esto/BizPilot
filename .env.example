# ============================================================
# BIZPILOT — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# Database (PostgreSQL / Neon Pooler)
DATABASE_URL="postgresql://username:password@ep-your-pooler.aws.neon.tech/neondb?sslmode=require"

# Vault AES-256-GCM Encryption Key (Derives 32-byte cryptography key)
CONNECTOR_ENCRYPTION_KEY="your_secure_vault_encryption_secret_key_2026_here"

# OAuth State Signing Secret (HMAC-SHA256 Anti-CSRF Token Signer)
OAUTH_STATE_SECRET="your_oauth_signing_secret_key_sha256_here"

# Meta (Facebook / Instagram / WhatsApp) Official App Configuration
# Required for Official 1-Click OAuth Sign-In
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
META_GRAPH_API_VERSION="v19.0"
META_GRAPH_BASE_URL="https://graph.facebook.com"
META_VERIFY_TOKEN="mtb_fb_verify_token_2026"

# WhatsApp Cloud API Webhook Verify Token
WHATSAPP_VERIFY_TOKEN="mtb_wa_verify_token_2026"

# TikTok for Business (Commercial Enterprise Partner Access)
# Optional: Requires ByteDance approved developer partner whitelisting
TIKTOK_CLIENT_KEY="your_tiktok_client_key_here"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret_here"

# Base Application URL
NEXT_PUBLIC_APP_URL="https://biz-pilot-1ltn.vercel.app"
